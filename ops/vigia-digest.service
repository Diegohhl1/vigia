[Unit]
Description=Vigía - Send Telegram digest
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/diego/Desktop/vigia
Environment="PATH=/home/diego/.local/bin:/home/diego/Desktop/vigia/.venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/diego/Desktop/vigia/.venv/bin/vigia digest

[Install]
WantedBy=default.target
